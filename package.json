{
  "name": "@frank9306/agent-skills",
  "version": "0.1.0",
  "private": true,
  "description": "Frank's reusable Agent Skills collection",
  "type": "module",
  "scripts": {
    "check": "node scripts/check-skills.mjs",
    "check:frontend": "node skills/engineering/frontend-design/scripts/verify-design.mjs .",
    "test:frontend": "node --test skills/engineering/frontend-design/tests/*.test.mjs",
    "test:read-web-content": "python -m unittest discover -s skills/content/read-web-content/tests -p \"test_*.py\"",
    "test:init-docs": "python -m unittest discover -s skills/engineering/init-docs/scripts/tests -p \"test_*.py\"",
    "test:manage-issues": "python -m unittest discover -s skills/engineering/manage-issues/scripts/tests -p \"test_*.py\"",
    "test:to-adr": "python -m unittest discover -s skills/engineering/to-adr/scripts/tests -p \"test_*.py\"",
    "test:ai-docs": "npm run test:init-docs && npm run test:manage-issues && npm run test:to-adr",
    "test": "npm run test:frontend && npm run test:read-web-content && npm run test:ai-docs"
  },
  "engines": {
    "node": ">=18"
  }
}
