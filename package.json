{
  "name": "@frank9306/agent-skills",
  "version": "0.1.0",
  "private": true,
  "description": "Frank's reusable Agent Skills collection",
  "type": "module",
  "scripts": {
    "check": "node scripts/check-skills.mjs",
    "check:frontend": "node skills/engineering/frontend-design/scripts/verify-design.mjs .",
    "test:frontend": "node --test skills/engineering/frontend-design/tests/*.test.mjs",
    "test:read-web-content": "python -m unittest discover -s skills/content/read-web-content/tests -p \"test_*.py\"",
    "test:dispatch-dsh-task": "python -m unittest discover -s skills/engineering/dispatch-dsh-task/scripts/tests -p \"test_*.py\"",
    "test:audit-codex-harness": "python -m unittest discover -s skills/engineering/audit-codex-harness/scripts/tests -p \"test_*.py\"",
    "test:init-docs": "python -m unittest discover -s skills/engineering/init-docs/scripts/tests -p \"test_*.py\"",
    "test:manage-issues": "python -m unittest discover -s skills/engineering/manage-issues/scripts/tests -p \"test_*.py\"",
    "test:to-adr": "python -m unittest discover -s skills/engineering/to-adr/scripts/tests -p \"test_*.py\"",
    "test:ai-docs": "npm run test:init-docs && npm run test:manage-issues && npm run test:to-adr",
    "test": "npm run test:frontend && npm run test:read-web-content && npm run test:dispatch-dsh-task && npm run test:audit-codex-harness && npm run test:ai-docs && npm run test:init-checks && npm run test:app-use",
    "test:app-use": "node --test skills/engineering/app-use/tests/bridge.test.mjs skills/engineering/app-use/tests/runner.test.mjs skills/engineering/app-use/tests/evidence.test.mjs",
    "test:app-use:desktop": "node --test --test-concurrency=1 skills/engineering/app-use/tests/desktop.test.mjs skills/engineering/app-use/tests/windows-live.test.mjs",
    "test:app-use:browser": "node --test --test-concurrency=1 skills/engineering/app-use/tests/browser-live.test.mjs skills/engineering/app-use/tests/acceptance-live.test.mjs",
    "test:app-use:laya": "node --test --test-concurrency=1 skills/engineering/app-use/tests/laya-live.test.mjs skills/engineering/app-use/tests/semantic-live.test.mjs",
    "test:init-checks": "node --test skills/engineering/init-checks/tests/typescript.test.mjs && python -m unittest discover -s skills/engineering/init-checks/tests -p \"test_*.py\""
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.6.0",
    "typescript": "^5.9.3"
  }
}
