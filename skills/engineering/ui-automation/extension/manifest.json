{
  "manifest_version": 3,
  "name": "app-use bridge",
  "version": "0.1.0",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
