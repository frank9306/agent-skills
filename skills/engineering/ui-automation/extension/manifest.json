{
  "manifest_version": 3,
  "name": "ui-automation",
  "version": "0.1.0",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ui-automation",
    "default_icon": {
      "16": "icons/bridge-16.png",
      "32": "icons/bridge-32.png",
      "48": "icons/bridge-48.png",
      "128": "icons/bridge-128.png"
    }
  },
  "description": "连接本机自动化服务，查看浏览器连接状态和活动会话。",
  "icons": {
    "16": "icons/bridge-16.png",
    "32": "icons/bridge-32.png",
    "48": "icons/bridge-48.png",
    "128": "icons/bridge-128.png"
  }
}
